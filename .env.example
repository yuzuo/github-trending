# Copy to .env and replace the local database password.
POSTGRES_PASSWORD=replace-with-a-local-password
WEB_PORT=8080
# For LAN access, set your server IP and WEB_PORT, e.g. http://192.168.1.169:8080
# Leave blank to use localhost; localhost remains available when a LAN origin is set.
APP_ORIGIN=
# Optional, but recommended to avoid GitHub's unauthenticated API limits.
GITHUB_TOKEN=
# Official Search API top N by total stars; 1-1000. Large values need a token for README requests.
SEARCH_LIMIT=100
# Base URL must include your provider's API prefix, for example https://provider.example/v1
TRANSLATION_BASE_URL=
TRANSLATION_MODEL=
TRANSLATION_API_KEY=
# Asia/Shanghai, 0-23. First startup also collects if today has no successful run.
COLLECT_HOUR=1
TRENDING_COLLECT_HOUR=1
SCHEDULE_ENABLED=true
# Also enables Crawler Watch: monitor every 6h, discovery daily; capacity 200.
# Watch metadata does not call the model; attention analysis uses TRANSLATION_* above.
# Automatic release checks also require the separate host worker (see README).
# Configure GITHUB_TOKEN above for reliable monitoring of many projects.
